# Затравка манифеста: копируем в билд-каталог только если манифеста там ещё нет.
# Живой пин (manifest.json рядом с бинарником) принадлежит каналу
# «lhctl engine update» и обновляется вне сборки; пересборка не имеет права его
# перезаписывать — иначе демон отчитывается не тем релизом, который
# установлен (расхождение теперь видно в /v0/engine, но лучше его не создавать).
if(NOT EXISTS "${DST}/manifest.json")
  file(COPY "${SRC}" DESTINATION "${DST}")
endif()
